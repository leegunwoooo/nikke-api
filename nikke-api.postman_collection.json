{
  "info": {
    "name": "nikke-api",
    "description": "Unofficial NIKKE data API — https://github.com/leegunwoooo/nikke-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://nikke-api-gunwoos-projects.vercel.app" },
    { "key": "openid", "value": "" }
  ],
  "item": [
    {
      "name": "Nikkes",
      "item": [
        {
          "name": "캐릭터 목록",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/nikkes?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "nikkes"],
              "query": [
                { "key": "q", "value": "", "disabled": true, "description": "이름 검색 (4개 언어 부분 일치)" },
                { "key": "element", "value": "", "disabled": true },
                { "key": "class", "value": "", "disabled": true },
                { "key": "burst", "value": "", "disabled": true },
                { "key": "corporation", "value": "", "disabled": true },
                { "key": "weapon", "value": "", "disabled": true },
                { "key": "rarity", "value": "", "disabled": true },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "캐릭터 상세 (id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/nikkes/201601", "host": ["{{baseUrl}}"], "path": ["api", "nikkes", "201601"] }
          }
        },
        {
          "name": "캐릭터 상세 (이름)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/nikkes/라피", "host": ["{{baseUrl}}"], "path": ["api", "nikkes", "라피"] }
          }
        }
      ]
    },
    {
      "name": "Scenes",
      "item": [
        {
          "name": "씬 목록",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/scenes?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scenes"],
              "query": [
                { "key": "category", "value": "", "disabled": true, "description": "main/event/sudden/attractive" },
                { "key": "nikke", "value": "", "disabled": true, "description": "니케 이름 (attractive 씬)" },
                { "key": "q", "value": "", "disabled": true, "description": "씬 제목 검색" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "씬 대본",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/scenes/d_ex_armory_01", "host": ["{{baseUrl}}"], "path": ["api", "scenes", "d_ex_armory_01"] }
          }
        }
      ]
    },
    {
      "name": "Favorites",
      "item": [
        {
          "name": "소장품 목록",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/favorites",
              "host": ["{{baseUrl}}"],
              "path": ["api", "favorites"],
              "query": [
                { "key": "q", "value": "", "disabled": true },
                { "key": "rare", "value": "", "disabled": true, "description": "R/SR/SSR" }
              ]
            }
          }
        },
        {
          "name": "소장품 상세",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/favorites/100101", "host": ["{{baseUrl}}"], "path": ["api", "favorites", "100101"] }
          }
        }
      ]
    },
    {
      "name": "Cubes",
      "item": [
        {
          "name": "큐브 목록",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cubes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cubes"],
              "query": [{ "key": "q", "value": "", "disabled": true }]
            }
          }
        },
        {
          "name": "큐브 상세",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/cubes/1000301", "host": ["{{baseUrl}}"], "path": ["api", "cubes", "1000301"] }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "유저 프로필",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/{{openid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "{{openid}}"],
              "description": "openid를 경로로. ?openid= 또는 ?url=<공유 URL 전체>도 가능"
            }
          }
        },
        {
          "name": "유저 프로필 (쿼리 형태)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user?openid={{openid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user"],
              "query": [
                { "key": "openid", "value": "{{openid}}", "description": "공유 링크의 openid 또는 전체 URL" }
              ]
            }
          }
        },
        {
          "name": "보유 니케 목록 (경량)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/{{openid}}/nikke",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "{{openid}}", "nikke"],
              "query": [
                { "key": "q", "value": "", "disabled": true, "description": "필터 — 이름 부분 일치/id/nameCode" }
              ]
            }
          }
        },
        {
          "name": "보유 니케 상세 (정확한 이름/id)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/{{openid}}/nikke/아니스%20%3A%20스타",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "{{openid}}", "nikke", "아니스%20%3A%20스타"],
              "description": "마지막 path = 정확한 이름(URL 인코딩) 또는 캐릭터 id/resourceId/nameCode"
            }
          }
        }
      ]
    },
    {
      "name": "Etc",
      "item": [
        {
          "name": "테이블 목록",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tables", "host": ["{{baseUrl}}"], "path": ["api", "tables"] }
          }
        },
        {
          "name": "테이블 조회",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tables/character_id_map.json", "host": ["{{baseUrl}}"], "path": ["api", "tables", "character_id_map.json"] }
          }
        },
        {
          "name": "필터 값 목록",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/meta/filters", "host": ["{{baseUrl}}"], "path": ["api", "meta", "filters"] }
          }
        },
        {
          "name": "CDN 경로→URL",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cdn?path=character/ko/nikke_list_v2.json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cdn"],
              "query": [{ "key": "path", "value": "character/ko/nikke_list_v2.json" }]
            }
          }
        }
      ]
    }
  ]
}
