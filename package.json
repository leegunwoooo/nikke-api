{
  "name": "nikke-data-api",
  "version": "0.7.0",
  "description": "NIKKE game data API — REST + MCP server over synced game data, runs on Node and Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:burst": "tsx scripts/sync-burst-cutscenes.ts",
    "build:burst-player": "tsx scripts/build-burst-player.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "build:data": "npm run sync && npm run build",
    "fetch:data": "node scripts/fetch-dist.mjs",
    "emit:pages-worker": "tsx scripts/emit-pages-worker.ts"
  },
  "keywords": [
    "nikke",
    "nikke-api",
    "mcp",
    "model-context-protocol",
    "hono",
    "cloudflare-workers",
    "cloudflare-pages",
    "game-data",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.9",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@esotericsoftware/spine-canvas": "^4.1.56",
    "@esotericsoftware/spine-core": "4.1.56",
    "@esotericsoftware/spine-webgl": "4.1.56",
    "@napi-rs/canvas": "^0.1.81",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "node-webpmux": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
